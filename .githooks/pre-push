#!/usr/bin/env bash
# Pre-push hook: builds Hugo site and commits public/ to gh-pages branch
set -euo pipefail

REPO_DIR="$(git rev-parse --show-toplevel)"
PUBLIC_DIR="$REPO_DIR/public"

# Build the site
echo "🔨 Building site with Hugo..."
hugo --source "$REPO_DIR"

# Check if public/ has actual content
if [ ! -f "$PUBLIC_DIR/index.html" ]; then
  echo "❌ Build failed: public/index.html not found."
  exit 1
fi

# Use git worktree to switch to gh-pages without losing uncommitted changes
echo "📦 Updating gh-pages branch..."
if git worktree list | grep -q "$REPO_DIR/.gh-pages-worktree"; then
  cd "$REPO_DIR/.gh-pages-worktree"
  git reset --hard HEAD
else
  git worktree add "$REPO_DIR/.gh-pages-worktree" gh-pages
  cd "$REPO_DIR/.gh-pages-worktree"
fi

# Clear old content and copy new build
find . -maxdepth 1 -not -name '.' -not -name '.git' -exec rm -rf {} +
cp -r "$PUBLIC_DIR/"* "$PUBLIC_DIR/".?* . 2>/dev/null || true

# Add and commit
git add -A
if git diff --cached --quiet; then
  echo "✅ No changes to deploy."
  cd "$REPO_DIR"
  git worktree remove "$REPO_DIR/.gh-pages-worktree" 2>/dev/null || true
  exit 0
fi

COMMIT_HASH=$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
git commit -m "Deploy from main@$COMMIT_HASH"

echo "✅ Committed to gh-pages branch."
cd "$REPO_DIR"
